# /root/nginx/conf.d/<share-host>.conf — a new, separate site; existing sites are untouched.
# TLS: Cloudflare Origin wildcard certificate, Cloudflare SSL mode "Full (strict)".
server {
    listen 80;
    listen [::]:80;
    server_name share.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name share.example.com;

    ssl_certificate     /etc/nginx/certs/example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/example.com/privkey.pem;
    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/cloudflare-realip.conf;

    access_log /var/log/nginx/share.example.com.access.log main;
    error_log  /var/log/nginx/share.example.com.error.log warn;

    # Cloudflare Free caps request bodies at 100 MB; the server enforces MAX_BLOB_MB (default 50).
    client_max_body_size 60m;

    location / {
        proxy_pass http://127.0.0.1:8787;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection        "";
        proxy_request_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
